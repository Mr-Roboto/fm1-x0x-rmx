# Audible browser/host parity with live Remix changes in all APPLY modes.
wav remix_parity.wav
wait 500
tapkey b0
tapkey w0
tapkey w8
wait 8
tap SEQ
turn SELECT 1
turn K4 -1
turn K2 1
tap PLAY
wait 480
turn K3 1
wait 480
turn K4 1
turn K2 1 80
turn K2 1 80
turn K2 1 80
wait 800
turn K4 1
turn K1 1
turn K3 -1
wait 2080
turn K4 1
turn K2 1
turn K3 1
wait 2080
tap PLAY
turn K1 1
wait 480
wavstop
